{
  "name": "viperpad-vscode",
  "displayName": "ViperPad",
  "description": "ViperPad as a VS Code webview editor.",
  "version": "1.0.1",
  "publisher": "BookMotives",
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#101b2d",
    "theme": "dark"
  },
  "keywords": [
    "editor",
    "document",
    "markdown",
    "pdf",
    "docx",
    "webview"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/odioski/viperpad-vscode.git"
  },
  "engines": {
    "vscode": "^1.92.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:viperpad.open"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "viperpad.open",
        "title": "ViperPad: Open"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "package": "npx --yes @vscode/vsce package",
    "publish": "npx --yes @vscode/vsce publish",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/vscode": "^1.92.0",
    "@typescript-eslint/eslint-plugin": "^7.16.1",
    "@typescript-eslint/parser": "^7.16.1",
    "eslint": "^8.57.0",
    "typescript": "^5.5.3"
  },
  "dependencies": {
    "docx": "^9.7.1",
    "mammoth": "^1.12.2",
    "pdfjs-dist": "^4.10.38"
  }
}
